# App
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
FRONTEND_URL=http://localhost:3000
COOKIE_DOMAIN=localhost

# Database
DATABASE_URL=mysql://root:@localhost:3306/nuedu

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-32-bytes-min
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-32-bytes-min
JWT_REFRESH_TTL=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=nuedu
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER_PREFIX=nuedu
CLOUDINARY_PRIVATE_URL_TTL=3600

# Frontend revalidation
NEXT_REVALIDATE_URL=http://localhost:3000/api/revalidate
NEXT_REVALIDATE_TOKEN=change-me-revalidate-token

# Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@nuedu.vn

# Seed
SEED_ADMIN_PASSWORD=Admin@123456
